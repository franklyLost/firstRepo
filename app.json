{
  "expo": {
    "name": "PlateMatch",
    "slug": "platematch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "platematch",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.platematch.app",
      "infoPlist": {
        "NSCameraUsageDescription": "PlateMatch needs camera access to photograph license plates.",
        "NSPhotoLibraryUsageDescription": "PlateMatch needs photo library access to upload plate images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "package": "com.platematch.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "PlateMatch needs camera access to photograph license plates."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
